<%= form_with url: url, model: task do |form| %>
  <%= form.label :title %>
  <%= form.text_field :title %>

  <%= form.label :description %>
  <%= form.text_field :description %>

  <%= form.hidden_field :team_id, value: task.team_id %>
  <%= form.hidden_field :author_id, value: task.author_id %>

  <%= form.label :assignee_id %>
  <%= form.collection_select(
      :assignee_id,
      # task.teams.users
      @team.users,
      :id, :email_address,
        { include_blank: "not assigned", }
      ) %>

  <%= form.submit %>
<% end %>