<div class="grid">
  <h1>Teams</h1>
  <%= button_to "Create team", new_team_path, method: :get if authenticated? %>
</div>
<% if authenticated? %>
  <% @teams.each do |team| %>
    <div class="card">
      <h3><%= link_to team.title, team_path(team) %></h3>
      <p><%= team.description %></p>
    </div>
  <% end %>
<% end %>