<h1>Teams</h1>
<% if authenticated? %>
  <%= button_to "Create team", new_team_path, method: :get %>
  <% @teams.each do |team| %>
    <div class="card">
      <h3><%= link_to team.title, team_path(team) %></h3>
      <p><%= team.description %></p>

      <% if team.user_teams.find_by(user: Current.user).owner? %>
        <div class="grid">
          <%= button_to "Edit", edit_team_path(team), method: :get, class: "secondary" %>
          <%= button_to "Delete", team_path(team), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "secondary" %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>